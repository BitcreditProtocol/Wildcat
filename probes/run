#!/usr/bin/env bash
# Runs every probe; exits non-zero when any fails.
set -uo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "${HERE}/.." && pwd)"
export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-${ROOT}/target}"
cp "${ROOT}/Cargo.lock" "${HERE}/Cargo.lock"
FAIL=0
cargo test --manifest-path "${HERE}/Cargo.toml" -j1 --no-fail-fast -- --test-threads=2 || FAIL=1
for s in "${HERE}"/sh/*.sh; do
  [ -e "$s" ] || continue
  echo "== $s"
  bash "$s" || { echo "FAILED: $s"; FAIL=1; }
done
exit "${FAIL}"
